# Personal Assistant - PRODUCTION environment (Vultr server)
# Copy to /opt/personal-assistant/.env on the server and fill in real values.
# The deploy script (deploy/vultr/deploy.sh) copies this template on first deploy.

# REQUIRED: OpenAI API key
OPENAI_API_KEY=your-openai-api-key-here

# REQUIRED: JWT signing secret (generate with: openssl rand -base64 48)
JWT_SECRET=change-me-generate-a-long-random-string

# REQUIRED: PostgreSQL password (generate with: openssl rand -hex 24)
POSTGRES_PASSWORD=change-me-strong-db-password

# Recommended: restrict CORS to your real origins, e.g.
# CORS_ORIGINS=https://assistant.example.com
CORS_ORIGINS=*

# Optional: Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Google Calendar via service account.
# Put the JSON file at ./secrets/google-service-account.json on the server,
# then set:
# GOOGLE_SERVICE_ACCOUNT_FILE=/app/secrets/google-service-account.json
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_CALENDAR_ID=primary

# Optional: research agent web search
SERP_API_KEY=
